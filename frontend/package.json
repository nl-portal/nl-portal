{
  "name": "nl-portal-frontend",
  "private": true,
  "packages": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm --filter \"nl-portal-app-dev...\" build",
    "build:watch": "pnpm clean && pnpm run --recursive --parallel build:watch",
    "clean": "pnpm run --recursive clean",
    "codegen": "pnpm run --recursive --parallel codegen",
    "dev": "pnpm clean && pnpm --parallel --filter \"nl-portal-app-dev...\" dev",
    "preview": "pnpm --filter \"nl-portal-app-dev\" preview",
    "app:build": "pnpm clean && pnpm --filter \"nl-portal-app...\" build",
    "app:dev": "pnpm clean && pnpm --parallel --filter \"nl-portal-app...\" dev",
    "app:preview": "pnpm --filter \"nl-portal-app\" preview",
    "lint": "eslint \"packages/**/*.{js,jsx,ts,tsx}\"",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:fix": "eslint \"packages/**/*.{js,jsx,ts,tsx}\" --fix",
    "preinstall": "npx only-allow pnpm",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "pnpm run --recursive --parallel test",
    "test:coverage": "pnpm run --recursive --parallel --filter '!./packages/app' --filter '!./packages/app-dev' test:coverage",
    "typecheck": "pnpm run --recursive --parallel typecheck",
    "update-patch": "npm-check-updates --configFilePath .ncurc.patch.js",
    "update-minor": "npm-check-updates --configFilePath .ncurc.minor.js",
    "update-major": "npm-check-updates --configFilePath .ncurc.major.js",
    "postinstall": "cd .. && husky frontend/.husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@commitlint/config-conventional": "20.5.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "npm-check-updates": "^19.2.0",
    "prettier": "3.9.6",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "stylelint": "16.26.1",
    "stylelint-config-standard-scss": "16.0.0",
    "stylelint-order": "7.0.1",
    "stylelint-selector-bem-pattern": "4.0.1",
    "typescript": "5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0 <12"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
