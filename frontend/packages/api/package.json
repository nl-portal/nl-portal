{
  "name": "@nl-portal/nl-portal-api",
  "version": "0.0.0",
  "author": "Ritense",
  "license": "EUPL-1.2",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "pnpm wait && tsc && vite build",
    "build:watch": "pnpm wait && tsc && vite build --watch --mode development",
    "clean": "rimraf dist",
    "codegen": "graphql-codegen --config codegen.ts",
    "dev": "pnpm wait && vite build --watch --mode development",
    "preinstall": "npx only-allow pnpm",
    "wait": "wait-on ../authentication/dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@apollo/client": "4.2.9",
    "graphql": "^16.14.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/client-preset": "^5.3.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@nl-portal/nl-portal-authentication": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "peerDependencies": {
    "@nl-portal/nl-portal-authentication": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
