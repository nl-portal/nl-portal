{
  "realm": "iko",
  "enabled": true,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "ROLE_ADMIN"
      }
    ],
    "client": {
      "iko": [
        {
          "name": "ROLE_JENV",
          "description": "IKO consumer: NL Portal"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "iko",
      "name": "IKO",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "hBLXFAV7LeXnHyBINdWPXwtu9GqznYl1",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8084/*"
      ],
      "webOrigins": [
        "/*"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "nl-portal",
      "name": "NL Portal (IKO consumer)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "jenv-portal-local-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "iko audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "iko",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "IKO",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ROLE_ADMIN"
      ]
    },
    {
      "username": "service-account-nl-portal",
      "enabled": true,
      "serviceAccountClientId": "nl-portal",
      "clientRoles": {
        "iko": [
          "ROLE_JENV"
        ]
      }
    }
  ]
}
